# Free AI keys (only used to turn messy text into fields). Leave blank to use cached replies only.
GROQ_API_KEY=
GEMINI_API_KEY=
# Any other OpenAI-compatible provider (OpenAI, OpenRouter, Mistral, DeepSeek, Together...): set all three
AI_BASE_URL=
AI_API_KEY=
AI_MODEL=
# Where the agent finds the mock inbox/tracker/calendar pages
APP_URL=http://localhost:5173
# 1 = run the browser without a window
HEADLESS=
# Google sign-in + the seller's Gmail/Calendar (see Google Cloud setup). Leave blank for the local demo without sign-in.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
# Comma-separated Google accounts allowed to sign in (also add them as test users in Google Cloud)
OWNER_EMAILS=
