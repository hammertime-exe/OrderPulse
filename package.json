{
  "name": "orderpulse",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vite",
    "api": "node --env-file-if-exists=.env server/dev.ts",
    "reset": "node -e \"require('fs').rmSync('data',{recursive:true,force:true})\"",
    "browsers": "playwright-core install chromium",
    "test": "node --test",
    "typecheck": "tsc",
    "build": "vite build"
  },
  "dependencies": {
    "react": "^19.3.1",
    "react-dom": "^19.3.1"
  },
  "devDependencies": {
    "@aws-sdk/client-dynamodb": "^3.1176.0",
    "@aws-sdk/client-lambda": "^3.1176.0",
    "@aws-sdk/lib-dynamodb": "^3.1176.0",
    "@sparticuz/chromium": "^153.0.0",
    "@tailwindcss/vite": "^4.3.5",
    "@types/node": "^26.6.6",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.3.0",
    "esbuild": "^0.28.2",
    "playwright-core": "^1.65.1",
    "tailwindcss": "^4.3.5",
    "typescript": "^7.0.2",
    "vite": "^8.3.8"
  }
}
